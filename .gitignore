### WEX Desktop ###
# Готовые сборки и упакованные дистрибутивы (сотни мегабайт, пересобираются из исходников)
/release/
# Кэш Gradle этого проекта
/.gradle/
# Локальные настройки IDE; общие (стиль кода, кодировки) при желании можно добавлять руками
/.idea/workspace.xml
/.idea/tasks.xml
/.idea/usage.statistics.xml
/.idea/dictionaries/
/.idea/shelf/
# Чужие ключи подписи сюда попадать не должны: свои WEX держит в ~/.config/wexdesktop/keys.
# Файлы app/src/main/resources/signing/testkey.* — это публичный тестовый ключ AOSP,
# часть ресурсов программы, и они версионируются намеренно.
*.jks
*.keystore
*.p12
