# Заглушка маркеров встраивания Kotlin (в kotlin-stdlib методы тоже пустые).
.class public final super Lkotlin/jvm/internal/InlineMarker;
.super Ljava/lang/Object;
.version 52

.method public static finallyStart(I)V
    .limit stack 0
    .limit locals 1
    return
.end method

.method public static finallyEnd(I)V
    .limit stack 0
    .limit locals 1
    return
.end method
