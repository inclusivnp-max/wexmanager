#!/usr/bin/env bash
# Запуск clazzpatcher из самодостаточного jar (app/build/libs/clazzpatcher.jar).
# Jar пересобирается (./gradlew :app:fatJar), если его нет или исходники новее.
# Параметры JVM: переменная CLAZZPATCHER_JAVA_OPTS (например, -Xmx8g); они идут после значений по умолчанию.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
JAR="$ROOT/app/build/libs/clazzpatcher.jar"

if [ ! -f "$JAR" ] || [ -n "$(find "$ROOT/app/src/main" "$ROOT/app/build.gradle.kts" -newer "$JAR" -print -quit)" ]; then
  "$ROOT/gradlew" -q -p "$ROOT" :app:fatJar >&2
  # Gradle не перезаписывает актуальный jar — обновляем время, чтобы не проверять снова
  touch "$JAR"
fi

# Разовый запуск на секунды: C1 без C2 прогревается быстрее (на 10–25 % быстрее в итоге), ParallelGC —
# меньше накладных расходов. Кэш кода побольше: при 48 МБ (по умолчанию для C1) его заполнение вызывает
# лишние полные сборки мусора. Для многоминутных задач: CLAZZPATCHER_JAVA_OPTS="-XX:TieredStopAtLevel=4".
# shellcheck disable=SC2086
exec java -Xss16m -XX:+UseParallelGC -XX:TieredStopAtLevel=1 -XX:ReservedCodeCacheSize=256m ${CLAZZPATCHER_JAVA_OPTS:-} -jar "$JAR" "$@"
